# shellm configuration
# Copy to ~/.local/store/shellm/.env and customize
# Add as many endpoint pairs as needed (incrementing _00, _01, _02...)

# Default model (auto-set by 'shellm benchmark' or 'shellm config')
# SHELLM_DEFAULT_MODEL=

# ── Endpoints ──────────────────────────────────────────────────────
# Ollama endpoints (auto-discovers all models on each)
OLLAMA_HOST_00=localhost
OLLAMA_PORT_00=11434
# OLLAMA_HOST_01=my-server
# OLLAMA_PORT_01=11434

# OpenAI-compatible API endpoints (vLLM, TGI, LiteLLM, etc.)
# OPENAI_COMPATIBLE_API_HOST_00=gpu-server-1
# OPENAI_COMPATIBLE_API_PORT_00=8000
# OPENAI_COMPATIBLE_API_HOST_01=gpu-server-2
# OPENAI_COMPATIBLE_API_PORT_01=8000

# ── Agent-Model Mapping ───────────────────────────────────────────
# Each agent maps explicitly to a model, endpoint, and provider.
# Set by 'shellm config' or edit directly. Format:
#   SHELLM_AGENT_{ID}_MODEL=<model-name>
#   SHELLM_AGENT_{ID}_ENDPOINT=<url>
#   SHELLM_AGENT_{ID}_PROVIDER=ollama|openai
#
# SHELLM_AGENT_GENERAL_MODEL=qwen2.5:3b
# SHELLM_AGENT_GENERAL_ENDPOINT=http://localhost:11434
# SHELLM_AGENT_GENERAL_PROVIDER=ollama
#
# SHELLM_AGENT_CODING_MODEL=qwen2.5:3b
# SHELLM_AGENT_CODING_ENDPOINT=http://localhost:11434
# SHELLM_AGENT_CODING_PROVIDER=ollama
#
# SHELLM_AGENT_RESEARCH_MODEL=Qwen3-32B-AWQ
# SHELLM_AGENT_RESEARCH_ENDPOINT=http://spark-1.local:8006
# SHELLM_AGENT_RESEARCH_PROVIDER=openai
#
# SHELLM_AGENT_DOCS_MODEL=qwen2.5:3b
# SHELLM_AGENT_DOCS_ENDPOINT=http://localhost:11434
# SHELLM_AGENT_DOCS_PROVIDER=ollama

# ── Settings ───────────────────────────────────────────────────────
AGENT_DEFAULT=general
SHELLM_DATA_DIR=~/.local/store/shellm
SHELLM_MEMORY_ENABLED=true
SHELLM_MEMORY_MAX_CONTEXT=5
SHELLM_NERD_FONTS=true
SHELLM_STREAM=true
